# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost:8000
# Set to "false" to route through live backend instead of mock data
NEXT_PUBLIC_DEMO_MODE=true

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# Set to "false" to call Python ML service for real predictions
DEMO_MODE=true

# Python ML service URL (used when DEMO_MODE=false)
ML_SERVICE_URL=http://localhost:8000

# Optional: PostgreSQL / Supabase (not required for demo mode)
# DATABASE_URL=postgresql://user:password@localhost:5432/cyberpredict
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=your_anon_key

# ─── ML Service ───────────────────────────────────────────────────────────────
# demo  → MockPredictor (default, no model required)
# model → TemporalGNNPredictor (requires trained checkpoint)
PREDICTOR_MODE=demo

# Path to trained model checkpoint (only used when PREDICTOR_MODE=model)
MODEL_CHECKPOINT_PATH=models/checkpoints/temporal_gnn.pt

# Graph time window size in minutes
WINDOW_MINUTES=5
